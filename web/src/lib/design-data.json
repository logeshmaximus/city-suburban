 "steps": [
  {
   "title": "You call, Rob listens",
   "text": "Tell us the make of the furnace or condenser and what it's doing. A good description often narrows it down on the phone."
  },
  {
   "title": "Pick a time",
   "text": "Monday to Saturday from 6 AM. High-rise visits are booked around your building's elevator and work hours."
  },
  {
   "title": "On-site diagnosis",
   "text": "The technician finds the actual fault: ignition, pressure, refrigerant, airflow or controls."
  },
  {
   "title": "Honest price, repair first",
   "text": "You hear the price before any work. If the unit has years left, we say so and repair it."
  },
  {
   "title": "We fix it",
   "text": "Repairs done on the spot where the part is on the van. Installs are scheduled and quoted separately."
  },
  {
   "title": "Good to go",
   "text": "The system is tested through a full cycle before we leave, and you know what to watch for."
  }
 ],
 "questions": [
  {
   "title": "Who diagnoses, and who quotes?",
   "text": "If they're different people, ask who owns the outcome. Here it's Rob for both."
  },
  {
   "title": "Is the technician on commission?",
   "text": "Commission on replacements changes what \"your furnace is done\" means."
  },
  {
   "title": "Does a permit count mean anything here?",
   "text": "Not for repairs. Chicago doesn't permit HVAC repair or maintenance, so a permit count only measures installs."
  },
  {
   "title": "What do the newest reviews say?",
   "text": "Read the last 20, not the top 5. Look for names and specifics."
  },
  {
   "title": "Will they tell you to keep it?",
   "text": "Ask if the unit has years left. Our reviewers record hearing \"yes\"."
  }
 ],
 "companies": [
  {
   "title": "Family-owned, since 1952",
   "text": "The owner answers and quotes. Limit: one family's capacity, so peak-winter days fill up.",
   "us": true
  },
  {
   "title": "National franchise",
   "text": "Response time is genuinely good. Limit: commission and price books shape the recommendation.",
   "us": false
  },
  {
   "title": "One-van independent",
   "text": "The work is often excellent. Limit: one person, so a January no-heat call can wait days.",
   "us": false
  },
  {
   "title": "Lead marketplace",
   "text": "Several quotes fast. Limit: you don't choose who calls back, or who turns up.",
   "us": false
  }
 ],
